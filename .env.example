# ─── PROD — environment ─────────────────────────────────────────────
# Copy to .env and adjust. Used by docker-compose.

# App
APP_NAME=PROD
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # generate with: docker compose run --rm api php artisan key:generate --show
APP_URL=http://localhost

# Public URL the browser uses to reach the API (through Caddy)
NEXT_PUBLIC_API_BASE=http://localhost/api/v1
CORS_ALLOWED_ORIGINS=http://localhost

# Database (real MySQL that serves PROD itself — not an in-game database)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=prod
DB_USERNAME=prod
DB_PASSWORD=change-me-please
DB_ROOT_PASSWORD=change-me-root

# Redis (cache / session / queue / rate limiting for PROD itself)
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Where the data-driven game content lives inside the API container
CONTENT_PATH=/content/data
