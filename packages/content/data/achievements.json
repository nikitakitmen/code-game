  { "id": "friday-deploy", "icon": "fire", "title": { "en": "Friday Deploy", "ru": "Пятничный деплой" }, "description": { "en": "Deploy to production on a Friday afternoon. Bold.", "ru": "Выкатить в прод в пятницу вечером. Смело." }, "when": { "fact": "stats.fridayDeploys", "gt": 0 } },
