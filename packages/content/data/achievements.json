  { "id": "rollback-artist", "icon": "rewind", "title": { "en": "Rollback Artist", "ru": "Мастер отката" }, "description": { "en": "Roll back a bad release to restore service.", "ru": "Откатить плохой релиз и вернуть сервис." }, "when": { "fact": "stats.rollbacks", "gt": 0 } },
