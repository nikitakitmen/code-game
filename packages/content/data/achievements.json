[
  { "id": "first-request", "icon": "trophy", "title": { "en": "First Request", "ru": "Первый запрос" }, "description": { "en": "Serve your very first page to a real user.", "ru": "Отдать первую страницу настоящему пользователю." }, "when": { "fact": "completed.m005", "truthy": true } },
